# --- App ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=*

# --- Database ---
# For local Docker Postgres see docker-compose.yml
DATABASE_URL=postgresql://talentx:talentx@localhost:5432/talentx?schema=public

# --- Clerk ---
# Dashboard: https://dashboard.clerk.com/ > API Keys
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Optional: JWT issuer, defaults auto-discovered via Clerk SDK
CLERK_JWT_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev

# --- Clerk webhook ---
# Dashboard > Webhooks > create endpoint -> pointing to POST /webhooks/clerk
# Subscribe to user.created, user.updated, user.deleted
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Sentry (optional in dev) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Rate limit (requests per minute per IP; 0 = disabled) ---
RATE_LIMIT_PER_MIN=120
